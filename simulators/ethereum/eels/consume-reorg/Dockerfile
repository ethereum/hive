# Runs the EELS (execution-specs) consume reorg simulator from the image published by
# ethereum/execution-specs. The image contains the simulator code and the
# blockchain_tests_engine_reorg fixtures it consumes.
# Use tag to select the tests; see ../README.md for build arguments.
ARG image=ghcr.io/ethereum/execution-specs/hive/consume-reorg
ARG tag=latest

FROM ${image}:${tag}
