// Shipped as go.mod.dist rather than go.mod on purpose.
//
// The simulator image compiles the generator inside the go-ethereum checkout
// it pins, so it needs no module file of its own. A local run needs one,
// with the replace pointing at a checkout of the PBT fork. hive's simulator
// build walks every go.mod under simulators/, so leaving one here would break
// a build that has nothing to do with this code.
//
// To run it locally, copy it into place first:
//
//	cp go.mod.dist go.mod && cp go.sum.dist go.sum
//	go run . -geth /path/to/geth -out /tmp/fixtures
//
// The replace path assumes hive and go-ethereum are siblings.
module github.com/ethereum/hive/simulators/ethereum/pbt-artifacts/fixtures/gen

go 1.24.0

require github.com/ethereum/go-ethereum v1.16.4

require (
	github.com/ProjectZKM/Ziren/crates/go-runtime/zkvm_runtime v0.0.0-20251001021608-1fe7b43fc4d6 // indirect
	github.com/StackExchange/wmi v1.2.1 // indirect
	github.com/VictoriaMetrics/fastcache v1.13.0 // indirect
	github.com/bits-and-blooms/bitset v1.20.0 // indirect
	github.com/cespare/xxhash/v2 v2.3.0 // indirect
