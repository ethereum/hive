# Ignore random stuff non important from hive's perspective
.git

# Ignore any local build artifacts and runtime caches
hive
hivechain
hiveview
workspace
target
**/target
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# The devp2p simulator builds from the repository root because it imports the
# local hivesim API. Keep unrelated repo areas out of that Docker context.
.circleci
clients
cmd
docs
hiveproxy
hivesim-rs
scripts
